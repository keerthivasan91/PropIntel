NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:5173

# Local MySQL connection
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=propintel
MYSQL_CONNECTION_LIMIT=10

# Gemini Developer API (server-side only)
# Create an API key in Google AI Studio. Never put this key in a VITE_ variable.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite


# Single administrator account for the internal /admin workspace
# Any non-empty admin password is accepted. Use root only for a local demo; choose a stronger value before public deployment.
# The session signing secret must still be random and at least 32 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_unique_password
SESSION_SECRET=replace_with_at_least_32_random_characters
